{:paths ["src/clojure" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        net.clojars.savya/hier-set {:mvn/version "1.3.0"}
        byteable/byteable {:mvn/version "0.2.0" :optional true}
        com.damballa/abracad {:mvn/version "0.4.13" :optional true}
        com.cognitect/transit-clj {:mvn/version "1.1.363" :optional true}
        com.taoensso/nippy {:mvn/version "3.8.1" :optional true}}

 :aliases
 {:test
  {:extra-paths ["test" "dev-resources" "target/classes"]
   :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                org.clojure/test.check {:mvn/version "1.1.3"}
                org.slf4j/slf4j-nop {:mvn/version "2.0.18"}
                ;; optional serialization backends (lein :provided) - present so the
                ;; s11n byteable/abracad tests exercise those code paths
                byteable/byteable {:mvn/version "0.2.0"}
                com.damballa/abracad {:mvn/version "0.4.13"}
                com.cognitect/transit-clj {:mvn/version "1.1.363"}
                com.taoensso/nippy {:mvn/version "3.8.1"}}
   :main-opts ["-m" "kaocha.runner"]}

  :1.10 {:override-deps {org.clojure/clojure {:mvn/version "1.10.3"}}}
  :1.11 {:override-deps {org.clojure/clojure {:mvn/version "1.11.4"}}}
  :1.12 {:override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
          slipset/deps-deploy {:mvn/version "0.2.5"}}
   :ns-default build}}}
